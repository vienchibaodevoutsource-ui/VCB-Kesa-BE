generator client {
  provider        = "prisma-client-js"
  // relationJoins: cho phép relationLoadStrategy = "join" — gộp include thành MỘT câu SQL
  // thay vì mỗi quan hệ một câu. Quan trọng vì mỗi lượt đi-về qua pooler tốn 300-500ms.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      Role     @default(MEMBER)
  isActive  Boolean  @default(true)
  canModerate Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamCode  String?
  team      TeamCode? @relation("TeamCodeUsers", fields: [teamCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  candidates Candidate[] @relation("CandidateCreator")
}

model CandidateCounter {
  id        String   @id @default(uuid())
  teamCode  String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model TeamCode {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   @relation("TeamCodeUsers")
  candidates Candidate[] @relation("CandidateTeam")
}

model Company {
  id              String      @id @default(uuid())
  name            String
  chineseName     String?
  slug            String      @unique
  type            CompanyType
  formType        String      // BROKER: form template. FACTORY: kế thừa từ công ty môi giới liên kết
  color           String?
  isActive        Boolean     @default(true)
  brokerCompanyId String?
  brokerCompany   Company?    @relation("FactoryBroker", fields: [brokerCompanyId], references: [id])
  factories       Company[]   @relation("FactoryBroker")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  brokerCandidates  Candidate[] @relation("BrokerCompany")
  factoryCandidates Candidate[] @relation("FactoryCompany")

  @@index([brokerCompanyId, type])
}

model Candidate {
  id                 String               @id @default(uuid())
  candidateCode      String?              @unique
  status             CandidateStatus      @default(COMPLETED)
  draftSessionId     String?
  createdByUserId    String?
  createdBy          User?                @relation("CandidateCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teamCode           String?
  team               TeamCode?            @relation("CandidateTeam", fields: [teamCode], references: [code], onDelete: SetNull, onUpdate: Cascade)
  lastSavedAt        DateTime?
  avatarUrl          String?
  lineImageUrl       String?
  isVerified         Boolean?             @default(false)
  verifiedById       String?
  verifiedByName     String?
  verifiedAt         DateTime?
  // Chuyển hồ sơ sang công ty/nhà máy khác: hồ sơ mới là bản nhân bản của hồ sơ nguồn.
  // applicantGroupId = id hồ sơ gốc của cả chuỗi chuyển; transferReason nằm ở hồ sơ MỚI.
  sourceCandidateId  String?
  source             Candidate?           @relation("CandidateTransfer", fields: [sourceCandidateId], references: [id], onDelete: SetNull)
  transfers          Candidate[]          @relation("CandidateTransfer")
  applicantGroupId   String?
  transferReason     String?
  nameSearch         String?
  chineseName        String?
  vietnameseName     String
  company            String?
  brokerId           String?
  factoryId          String?
  broker             Company?             @relation("BrokerCompany", fields: [brokerId], references: [id])
  factory            Company?             @relation("FactoryCompany", fields: [factoryId], references: [id])
  gender             String
  dateOfBirth        String?
  age                Int?
  height             Int?
  weight             Int?
  education          String?
  maritalStatus      String?
  passport           String?
  criminalRecord     String?
  healthCheck        String?
  address            String?
  religion           String?
  visionLeft         String?
  visionRight        String?
  handedness         String?
  smoking            String?
  drinking           String?
  colorBlindness     String?
  tattoos            String?
  languages          String[]
  workExperience     String?
  domesticExperience String?
  overseasExperience String?
  note               String?
  cccd               String?
  phone              String?              // SĐT người lao động
  relativePhone      String?              // SĐT người thân
  formDataJson       String?              // Toàn bộ dữ liệu form dạng JSON - dùng để restore khi chỉnh sửa
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  canStandLong       Boolean?             @default(true)
  canWorkOvertime    Boolean?             @default(true)
  canWorkRotation    Boolean?             @default(true)
  glassesDegree      String?
  hadSeriousIllness  Boolean?             @default(false)
  hadSurgery         Boolean?             @default(false)
  hasAstigmatism     Boolean?             @default(false)
  hasScars           Boolean?             @default(false)
  hasTattoo          Boolean?             @default(false)
  healthIssueDesc    String?
  illnessDescription String?
  isColorBlind       Boolean?             @default(false)
  isHealthy          Boolean?             @default(true)
  limbImages         String[]
  limbsIntact        Boolean?             @default(true)
  maxLiftKg          Int?
  needsGlasses       Boolean?             @default(false)
  noPrefForDept      Boolean?             @default(true)
  scarDescription    String?
  scarImages         String[]
  surgeryDescription String?
  sweaty             Boolean?             @default(false)
  tattooImages       String[]
  familyMembers      FamilyMember[]
  interviews         InterviewCandidate[]
  formSnapshot       CandidateFormSnapshot?
  partnerSyncs       PartnerSync[]
  partnerSyncLogs    PartnerSyncLog[]

  @@index([status, draftSessionId])
  @@index([createdByUserId])
  @@index([teamCode])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([nameSearch])
  @@index([applicantGroupId])
  @@index([sourceCandidateId])
}

model CandidateFormSnapshot {
  id          String    @id @default(uuid())
  candidateId String    @unique
  formType    String?
  data        Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([formType])
}

// Lần đẩy hồ sơ sang dự án của đối tác (長青). Mỗi hồ sơ × đối tác 1 dòng.
model PartnerSync {
  id              String    @id @default(uuid())
  candidateId     String
  partner         String    // 'evergreen'
  projectCode     String?   // mã dự án bên đối tác (Project_Settings cột A)
  partnerWorkerId String?   // workerId đối tác trả về, vd VN-KESA-7F3K2
  extras          Json      @default("{}") // giá trị nhập bổ sung cho các trường kesa không có
  answers         Json      @default("{}") // câu trả lời phỏng vấn người dùng nhập, theo questionId của 長青
  questionSnapshot Json?    // bộ câu hỏi lúc đẩy thành công gần nhất → so với bộ hiện tại để báo câu mới/đã sửa
  status          String    // SENT | FAILED
  lastError       String?
  lastSentAt      DateTime?
  lastSentVersion DateTime? // Candidate.updatedAt lúc đẩy thành công → biết hồ sơ đã sửa sau lần đẩy
  sentById        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, partner])
}

// Lịch sử từng lần đẩy hồ sơ sang đối tác: lưu nguyên dữ liệu đã gửi (kể cả phần người dùng nhập bổ sung / trả lời
// phỏng vấn) để sau này tra lại hoặc cung cấp cho khách hàng. Chỉ thêm, không sửa. Xoá hồ sơ vẫn giữ log (candidateId → null).
model PartnerSyncLog {
  id              String     @id @default(uuid())
  candidateId     String?
  candidateCode   String?    // giữ lại mã hồ sơ phòng khi hồ sơ bị xoá
  partner         String
  projectCode     String
  partnerWorkerId String?
  status          String     // SENT | FAILED
  error           String?
  extras          Json       @default("{}") // người dùng nhập bổ sung (chỉ phần khác giá trị map từ form)
  answers         Json       @default("{}") // câu trả lời người dùng nhập (chỉ phần khác giá trị kesa tự điền)
  sent            Json       // nguyên application + worker (kèm interview) đã gửi, không có accessCode
  sentById        String?
  createdAt       DateTime   @default(now())
  candidate       Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([candidateId, createdAt])
}

model FamilyMember {
  id           String    @id @default(uuid())
  candidateId  String
  name         String?
  relationship String
  age          Int?
  occupation   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model InterviewList {
  id             String               @id @default(uuid())
  title          String
  taiwanCompany  String?
  vietnamCompany String?
  examDate       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  candidates     InterviewCandidate[]
}


model InterviewCandidate {
  id               String        @id @default(uuid())
  interviewListId  String
  candidateId      String
  mathEnglishScore String?
  beanPickingScore String?
  preferenceOrder  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  candidate        Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewList    InterviewList @relation(fields: [interviewListId], references: [id], onDelete: Cascade)

  @@unique([interviewListId, candidateId])
}

model Registration {
  id          String             @id @default(uuid())
  status      RegistrationStatus @default(PENDING)
  formType    String?
  fullName    String
  phone       String?
  birthYear   String?
  hometown    String?
  gender      String?
  height      String?
  weight      String?
  payloadJson String?
  note        String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
}

enum Role {
  MEMBER
  ADMIN
}

enum CompanyType {
  BROKER
  FACTORY
}

enum CandidateStatus {
  DRAFT
  COMPLETED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

